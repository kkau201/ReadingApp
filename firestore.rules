rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Every document belongs to one Firebase Auth user. Nothing is shared between
// users and nothing is public. Anything not matched below is denied.
//
// Collection: users
// Document ID: the owner's Firebase Auth uid (users/{uid})
// Fields (all required, no others allowed):
//   - user_id: string (== document ID, immutable)
//   - display_name: string (1-16 chars, required)
//   - avatar_url: string | null ('' or 'avatar_1'..'avatar_7')
//   - quote: string (0-100 chars)
//   - reading_goal: int (1-24)
//
// Collection: books
// Document ID: auto-generated
// Fields:
//   - user_id: string (required, == owner uid, immutable)
//   - google_book_id: string (required, 1-100 chars)
//   - title: string (optional, 1-500 chars)
//   - authors: list<string> (optional, 1-10 entries, each 1-200 chars)
//   - book_photo_url: string (optional, http(s) URL, max 2000 chars)
//   - page_count: int (optional, 1-100000)
//   - notes: string (optional, 1-1000 chars)
//   - rating: number (optional, 1-5)
//   - started_reading: timestamp (optional)
//   - finished_reading: timestamp (optional)
//   - finished_on: string (optional, display date, 1-50 chars)
//   Optional fields are removed (not set to null) when cleared.
//
// Collection: sessions (create / read / delete only, never updated)
// Document ID: auto-generated
// Fields:
//   - user_id: string (required, == owner uid)
//   - pages: int (required, 1-99999)
//   - read_on: string (required, display date, 1-50 chars)
//   - read_at: timestamp (required)
//   - google_book_id: string (optional, 1-100 chars)
//   - title: string (optional, 1-500 chars)
//   - note: string (optional, 1-500 chars)
//
// Queries the app runs (all must stay allowed):
//   - users/{uid} get
//   - books where user_id == uid
//   - sessions where user_id == uid
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // Helper Functions
    // =============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // The existing document belongs to the caller (read / update / delete).
    function isDocOwner() {
      return isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // Optional string field: absent, or a string within the length bounds.
    function optionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function optionalIntInRange(data, field, min, max) {
      return !(field in data) ||
        (data[field] is int && data[field] >= min && data[field] <= max);
    }

    function isValidUrl(url) {
      return url is string && url.size() <= 2000 &&
        (url.matches('^https://.*') || url.matches('^http://.*'));
    }

    // Rules can't loop, so each index of the (max 10) authors list is checked.
    function isAuthorAt(authors, i) {
      return authors.size() <= i ||
        (authors[i] is string && authors[i].size() >= 1 && authors[i].size() <= 200);
    }

    function isValidAuthors(authors) {
      return authors is list && authors.size() >= 1 && authors.size() <= 10 &&
        isAuthorAt(authors, 0) && isAuthorAt(authors, 1) && isAuthorAt(authors, 2) &&
        isAuthorAt(authors, 3) && isAuthorAt(authors, 4) && isAuthorAt(authors, 5) &&
        isAuthorAt(authors, 6) && isAuthorAt(authors, 7) && isAuthorAt(authors, 8) &&
        isAuthorAt(authors, 9);
    }

    // =============================================================
    // Domain Validators (used by both create and update)
    // =============================================================

    function isValidUser(data, userId) {
      let fields = ['user_id', 'display_name', 'avatar_url', 'quote', 'reading_goal'];
      return data.keys().hasAll(fields) &&
        data.keys().hasOnly(fields) &&
        data.user_id == userId &&
        data.display_name is string &&
          data.display_name.size() >= 1 && data.display_name.size() <= 16 &&
        (data.avatar_url == null || data.avatar_url in
          ['', 'avatar_1', 'avatar_2', 'avatar_3', 'avatar_4', 'avatar_5', 'avatar_6', 'avatar_7']) &&
        data.quote is string && data.quote.size() <= 100 &&
        data.reading_goal is int && data.reading_goal >= 1 && data.reading_goal <= 24;
    }

    function isValidBook(data) {
      return data.keys().hasAll(['user_id', 'google_book_id']) &&
        data.keys().hasOnly([
          'user_id', 'google_book_id', 'title', 'authors', 'book_photo_url', 'page_count',
          'notes', 'rating', 'started_reading', 'finished_reading', 'finished_on'
        ]) &&
        data.user_id == request.auth.uid &&
        data.google_book_id is string &&
          data.google_book_id.size() >= 1 && data.google_book_id.size() <= 100 &&
        optionalString(data, 'title', 1, 500) &&
        (!('authors' in data) || isValidAuthors(data.authors)) &&
        (!('book_photo_url' in data) || isValidUrl(data.book_photo_url)) &&
        optionalIntInRange(data, 'page_count', 1, 100000) &&
        optionalString(data, 'notes', 1, 1000) &&
        (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5)) &&
        optionalTimestamp(data, 'started_reading') &&
        optionalTimestamp(data, 'finished_reading') &&
        optionalString(data, 'finished_on', 1, 50);
    }

    function isValidSession(data) {
      return data.keys().hasAll(['user_id', 'pages', 'read_on', 'read_at']) &&
        data.keys().hasOnly([
          'user_id', 'google_book_id', 'title', 'pages', 'note', 'read_on', 'read_at'
        ]) &&
        data.user_id == request.auth.uid &&
        data.pages is int && data.pages >= 1 && data.pages <= 99999 &&
        data.read_on is string && data.read_on.size() >= 1 && data.read_on.size() <= 50 &&
        data.read_at is timestamp &&
        optionalString(data, 'google_book_id', 1, 100) &&
        optionalString(data, 'title', 1, 500) &&
        optionalString(data, 'note', 1, 500);
    }

    // =============================================================
    // Collections
    // =============================================================

    // Profiles are private: only the owner can read or write their own.
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data, userId);
    }

    match /books/{bookId} {
      // Covers get-by-id and the app's `where user_id == uid` list query.
      allow read, delete: if isDocOwner();
      allow create: if isAuthenticated() && isValidBook(request.resource.data);
      // isValidBook requires user_id == caller, so ownership can't be transferred.
      allow update: if isDocOwner() && isValidBook(request.resource.data);
    }

    match /sessions/{sessionId} {
      allow read, delete: if isDocOwner();
      allow create: if isAuthenticated() && isValidSession(request.resource.data);
      // No update: the app never edits a session.
    }
  }
}
